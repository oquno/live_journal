[Unit]
Description=Live Journal
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/live_journal
Environment=LIVE_JOURNAL_DB=/opt/live_journal/data/live_journal.db
Environment=LIVE_JOURNAL_MODE=private
Environment=LIVE_JOURNAL_USER=admin
EnvironmentFile=/etc/live-journal.env
ExecStart=/opt/live_journal/.venv/bin/gunicorn wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
